APP_NAME=Supriz
APP_ENV=production
# Générer sur le serveur avec : php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE='Africa/Porto-Novo'
APP_URL=https://votredomaine.com

# ---------------------------------------------------------------------------
# FedaPay (paiements) — renseigner les VRAIES clés directement dans le .env
# du serveur, jamais dans ce fichier versionné.
# FEDAPAY_ENV : sandbox | live
# ---------------------------------------------------------------------------
FEDAPAY_ENV=live
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=

# Connexion sociale (client IDs autorisés, séparés par des virgules)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Secret protégeant les endpoints /cron/*
CRON_SECRET_KEY=

# Firebase
FIREBASE_PROJECT_ID=supriz-bb081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# À CONFIGURER AVEC LES INFOS HOSTINGER
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_supriz
DB_USERNAME=u123456789_supriz_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL - À CONFIGURER AVEC HOSTINGER EMAIL
MAIL_MAILER=smtp
MAIL_HOST=mail.votredomaine.com
MAIL_PORT=465
MAIL_USERNAME="contact@votredomaine.com"
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="contact@votredomaine.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
